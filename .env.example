# Development-only values. Use a secret manager outside local development.
POSTGRES_DB=aurora
POSTGRES_USER=aurora
POSTGRES_PASSWORD=change-me-for-your-machine
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
APP_ENV=development
APP_VERSION=dev
DATABASE_MAX_OPEN_CONNS=10
